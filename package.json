{
  "name": "hebra-mcp",
  "version": "0.1.0",
  "description": "Servidor MCP que lee, crea, edita y organiza notas en la biblioteca de Hebra, sobre node:sqlite.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "hebra-mcp": "dist/cli.mjs"
  },
  "dependencies": {
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@lezer/markdown": "1.7.2",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@napi-rs/keyring": "2.1.0",
    "express": "5.2.1",
    "zod": "4.6.5"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1",
    "check:bundle": "npm run build && node scripts/check-bundle.mjs",
    "check:no-hebra-code": "node scripts/check-no-hebra-code.mjs",
    "check": "npm run typecheck && npm run check:no-hebra-code && npm run test && npm run check:bundle"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.0",
    "esbuild": "0.25.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
